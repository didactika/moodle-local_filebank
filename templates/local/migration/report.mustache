    @template local_filebank/local/migration/report
    Bounded live review, explicit conflict resolutions and separate execution.
    Example context (json): {"planid":1,"planstate":"Blocked","courses":[],"issues":[],"runs":[]}
}}
<section class="filebank-admin filebank-migration" data-region="filebank-migration" data-planid="{{planid}}" data-digest="{{digest}}" data-contextid="{{contextid}}" data-sesskey="{{sesskey}}" data-total="{{total}}" data-included="{{included}}">
    <div class="filebank-actionbar mb-3 d-flex align-items-center flex-wrap">{{#reviewstep}}<a class="btn btn-sm btn-outline-secondary filebank-back" href="{{newplanurl}}">{{#pix}}t/left, core{{/pix}} {{#str}}changescope, local_filebank{{/str}}</a>{{/reviewstep}}{{#executionstep}}<a href="{{reviewurl}}" class="btn btn-sm btn-outline-secondary filebank-back">{{#pix}}t/left, core{{/pix}} {{#str}}backtoreview, local_filebank{{/str}}</a>{{/executionstep}}</div>
    <h2>{{#str}}report, local_filebank{{/str}}</h2>
    <ol class="filebank-steps mb-3" aria-label="{{#str}}migrationsteps, local_filebank{{/str}}">
        <li><span class="filebank-step-number">1</span>{{#str}}migrationstep_profile, local_filebank{{/str}}</li>
        <li><span class="filebank-step-number">2</span><a href="{{newplanurl}}">{{#str}}migrationstep_scope, local_filebank{{/str}}</a></li>
        <li {{#reviewstep}}aria-current="step"{{/reviewstep}}><span class="filebank-step-number">3</span><a href="{{reviewurl}}">{{#str}}migrationstep_review, local_filebank{{/str}}</a></li>
        <li {{#executionstep}}aria-current="step"{{/executionstep}}><span class="filebank-step-number">4</span>{{#str}}migrationstep_execute, local_filebank{{/str}}</li>
    </ol>
    {{#sourceedition}}<p class="small text-muted">{{sourceedition}} → {{targetedition}}</p>{{/sourceedition}}
    <div class="filebank-toolbar d-flex align-items-center justify-content-between flex-wrap my-2"><span class="filebank-chip" data-filebank-planstate>{{planstate}}</span><span class="small text-muted" data-filebank-includedlabel>{{includedlabel}}</span></div>
    <div class="filebank-metrics mb-3">{{#metrics}}<div class="card"><div class="card-body py-2"><strong>{{count}}</strong> <span class="small">{{label}}</span></div></div>{{/metrics}}</div>
    <details class="mb-3"><summary><span class="filebank-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span>{{#str}}reviewedrules, local_filebank{{/str}}</summary><div class="mt-3">{{#summary}}{{> local_filebank/local/profile/summary}}{{/summary}}</div></details>
    <div class="alert alert-info" data-filebank-empty {{^emptycancelled}}hidden{{/emptycancelled}}>{{#str}}emptymigration, local_filebank{{/str}}</div>
    {{#hasissues}}<section class="filebank-panel filebank-issues">
        <h3 class="h5">{{#str}}reviewissues, local_filebank{{/str}}</h3>
        {{#issues}}<div class="filebank-issue border-bottom py-3">
            <div class="filebank-issue-description"><strong class="small">{{description}}</strong><div class="small text-muted text-break filebank-issue-context" title="{{context}}">{{context}}</div></div>
            {{#resolvable}}<form method="post" action="{{actionurl}}" data-filebank-resolution>
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="digest" value="{{digest}}"><input type="hidden" name="kind" value="issue"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="action" value="resolve">
                <label class="small" for="mp-issue-{{id}}">{{#str}}resolvemigration, local_filebank{{/str}} </label> {{{help}}}
                <select id="mp-issue-{{id}}" name="choice" class="custom-select custom-select-sm" data-filebank-resolve><option value="">{{#str}}choose_resolution, local_filebank{{/str}}</option>{{#choices}}<option value="{{value}}">{{label}}</option>{{/choices}}</select>
                <noscript><button class="btn btn-sm btn-primary">{{#str}}filter, core{{/str}}</button></noscript>
            </form>{{/resolvable}}
        </div>{{/issues}}
        {{{issuepagination}}}
    </section>{{/hasissues}}
    {{#reviewstep}}
    <form method="get" action="{{actionurl}}" class="filebank-toolbar d-flex align-items-center justify-content-between flex-wrap my-2" data-filebank-review-search>
        <input type="hidden" name="planid" value="{{planid}}"><input type="hidden" name="perpage" value="{{perpage}}">
        <div class="filebank-table-search"><label for="filebank-migration-q" class="small">{{#str}}migrationsearch, local_filebank{{/str}} </label> {{{searchhelp}}}<div class="input-group input-group-sm"><input type="search" name="q" id="filebank-migration-q" value="{{search}}" class="form-control"><button class="btn btn-outline-secondary" type="submit" aria-label="{{#str}}search, core{{/str}}">{{#pix}}a/search, core{{/pix}}</button></div></div>
        <nav aria-label="{{#str}}decision, local_filebank{{/str}}"><ul class="nav nav-pills flex-wrap">{{#filters}}<li class="nav-item"><a href="{{url}}" class="nav-link small {{#active}}active{{/active}}" {{#current}}aria-current="{{current}}"{{/current}}>{{label}} ({{count}})</a></li>{{/filters}}</ul></nav>
    </form>
    <form method="post" action="{{actionurl}}" data-filebank-migration-selection>
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="digest" value="{{digest}}"><input type="hidden" name="q" value="{{search}}"><input type="hidden" name="page" value="{{page}}"><input type="hidden" name="decision" value="{{decision}}"><input type="hidden" name="issuepage" value="{{issuepage}}"><input type="hidden" name="perpage" value="{{perpage}}">
        {{#selectioneditable}}<div class="filebank-toolbar d-flex align-items-center justify-content-between flex-wrap my-2"><div class="d-inline-flex align-items-center filebank-actionbar"><label class="mb-0 small"><input type="checkbox" data-filebank-selectall data-partial="{{allpartial}}" {{#allchecked}}checked{{/allchecked}}> {{#str}}selectall, core{{/str}}</label>{{{selectionhelp}}}</div><span class="small text-muted" role="status" data-filebank-save-status></span></div>{{/selectioneditable}}
        {{#courses}}<details open class="filebank-migration-group mb-3" data-filebank-group="{{groupcourseid}}">
            <summary><span class="filebank-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span><span class="text-break">{{{sourcecoursehtml}}} → {{{targetcoursehtml}}}</span>{{#selectioneditable}}<input type="checkbox" data-filebank-course="{{groupcourseid}}" data-total="{{coursetotal}}" data-included="{{courseincluded}}" aria-label="{{#str}}selectcourse, local_filebank{{/str}}" {{#coursechecked}}checked{{/coursechecked}} data-partial="{{coursepartial}}">{{/selectioneditable}}</summary>
            {{#folders}}<details open class="filebank-migration-folder mt-2" data-filebank-folder-group="{{groupcmid}}"><summary><span class="filebank-disclosure-icon" aria-hidden="true">{{#pix}}t/collapsedchevron, core{{/pix}}</span><span class="text-break">{{{sourcefolderhtml}}} → {{{targetfolderhtml}}}</span>{{#selectioneditable}}<input type="checkbox" data-filebank-folder="{{groupcmid}}" data-total="{{grouptotal}}" data-included="{{groupincluded}}" data-course="{{groupcourseid}}" aria-label="{{#str}}selectfolder, local_filebank{{/str}}" {{#groupchecked}}checked{{/groupchecked}} data-partial="{{grouppartial}}">{{/selectioneditable}}</summary>
                <p class="small text-muted mt-2 text-break">{{{targetsectionhtml}}}</p>
                <ul class="list-group list-group-flush">{{#operations}}<li class="list-group-item px-0" data-filebank-operation="{{id}}">
                    <div class="row"><div class="col-md-7">
                        {{#selectioneditable}}<input type="hidden" name="visible[]" value="{{id}}"><input type="checkbox" name="included[]" value="{{id}}" data-source-course="{{sourcecourseid}}" data-source-folder="{{sourcecmid}}" {{#included}}checked{{/included}} aria-label="{{filename}}">{{/selectioneditable}}
                        <strong class="small text-break">{{filename}}</strong> <span class="filebank-chip" data-filebank-excluded {{#included}}hidden{{/included}}>{{#str}}excluded, local_filebank{{/str}}</span><div class="small text-muted text-break">{{filepath}}</div><div class="small text-break">{{author}} · {{license}}</div>
                    </div><div class="col-md-5 mt-2 mt-md-0"><span class="filebank-chip">{{decisionlabel}}</span><div class="small">{{statelabel}}</div>{{#resultlabel}}<div class="small">{{resultlabel}}</div>{{/resultlabel}}
                    {{#resolvable}}<label for="mp-file-{{id}}" class="small">{{#str}}resolvemigration, local_filebank{{/str}} </label> {{{resolutionhelp}}}<select id="mp-file-{{id}}" class="custom-select custom-select-sm" data-filebank-file-resolution="{{id}}"><option value="">{{#str}}choose_resolution, local_filebank{{/str}}</option><option value="overwrite">{{#str}}overwrite_file, local_filebank{{/str}}</option></select>{{/resolvable}}
                    </div></div>
                </li>{{/operations}}</ul>
            </details>{{/folders}}
        </details>{{/courses}}
        {{^hasoperations}}<p class="alert alert-info">{{#str}}nofilteredoperations, local_filebank{{/str}}</p>{{/hasoperations}}
        <noscript><button class="btn btn-sm btn-primary" name="action" value="selection">{{#str}}saveselection, local_filebank{{/str}}</button></noscript>
    </form>
    {{{pagination}}}
    <div class="filebank-page-actions d-flex align-items-center flex-wrap py-3 mt-3 border-top">

        <a href="{{executionurl}}" class="btn btn-primary btn-sm {{^canexecute}}disabled{{/canexecute}}" role="button" data-filebank-continue aria-disabled="{{^canexecute}}true{{/canexecute}}{{#canexecute}}false{{/canexecute}}" {{^canexecute}}tabindex="-1"{{/canexecute}}>{{#str}}continueexecution, local_filebank{{/str}} {{#pix}}t/right, core{{/pix}}</a>
    </div>
    {{/reviewstep}}
    {{#executionstep}}
        {{#hasruns}}<section class="mb-3"><h3 class="h5">{{#str}}planprogress, local_filebank{{/str}}</h3><p>{{planprogress}}</p><progress class="w-100" value="{{plancompleted}}" max="{{plantotal}}" aria-label="{{planprogress}}"></progress></section>{{/hasruns}}
        {{#runs}}<div class="filebank-toolbar d-flex align-items-center justify-content-between flex-wrap my-2"><span>{{#str}}runreference, local_filebank, {{id}}{{/str}} · {{statelabel}}</span>{{#cancancel}}<form method="post" action="{{actionurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="runid" value="{{id}}"><button class="btn btn-sm btn-outline-warning" name="action" value="cancel">{{#str}}cancelrun, local_filebank{{/str}}</button></form>{{/cancancel}}</div>{{/runs}}
        <form method="post" action="{{actionurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="digest" value="{{digest}}">
            {{#canexecute}}<p>{{#str}}reviewbeforeexecute, local_filebank{{/str}}</p>{{{executionhelp}}}{{/canexecute}}
            <div class="filebank-page-actions d-flex align-items-center flex-wrap py-3 mt-3 border-top">{{#hasruns}}<a href="{{refreshurl}}" class="btn btn-sm btn-outline-secondary">{{#str}}refreshstatus, local_filebank{{/str}}</a>{{/hasruns}}<button class="btn btn-sm btn-primary" name="action" value="execute" {{^canexecute}}disabled{{/canexecute}}>{{#str}}execute, local_filebank{{/str}}</button></div>
        </form>
    {{/executionstep}}
</section>
